# Optional but recommended: Reddit OAuth (script-type app)
# https://www.reddit.com/prefs/apps
# Without these, the scraper falls back to public JSON → Arctic Shift → RSS.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ruppscraper:rateuprofs-indexer:1.0 (by /u/your_username)

# Optional: override Arctic Shift archive base URL
# ARCTIC_SHIFT_BASE=https://arctic-shift.photon-reddit.com
